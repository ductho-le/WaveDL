{
  "name": "wavedl-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p tsconfig.app.json",
    "test": "nuxt prepare && vitest run",
    "lint": "oxlint app nuxt.config.ts vitest.config.ts test/workstation",
    "format": "oxfmt app nuxt.config.ts vitest.config.ts tsconfig.app.json test/workstation",
    "format:check": "oxfmt --check app nuxt.config.ts vitest.config.ts tsconfig.app.json test/workstation"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "@nuxtjs/i18n": "10.2.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion-v": "2.8.0",
    "nuxt": "4.5.2",
    "pinia": "4.1.0",
    "reka-ui": "2.10.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "uplot": "1.6.32",
    "vee-validate": "5.0.0-beta.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.16",
    "vue-router": "5.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/fonts": "1.1.0",
    "@oxlint/plugins": "1.77.0",
    "@pinia/nuxt": "1.0.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.2.0",
    "@unhead/vue": "3.4.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "@vueuse/nuxt": "15.0.0",
    "happy-dom": "20.11.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.77.0",
    "shadcn-nuxt": "2.8.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

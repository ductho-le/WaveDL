{
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": [
    ".nuxt",
    ".output",
    "dist",
    "node_modules",
    ".wrangler",
    ".data",
    "coverage",
    "*.min.js",
    "*.min.css",
    "app/components/ui",
    "content",
    "skills",
    "server/db/migrations",
    "**/CHANGELOG.md",
    "pnpm-lock.yaml",
    "bun.lock",
  ],
}
